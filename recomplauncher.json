{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "AMPEDUP!",
  "repo": "AMPEDUP-2001/AMPEDUP",
  "min": "0.90.0-beta.51",
  "game": {
    "kind": "iso_or_folder",
    "label": "Your European multilingual retail Amped XISO (.iso) or its extracted folder.",
    "check": {
      "file": "default.xbe",
      "xdvdfs": "default.xbe"
    },
    "dumps": [
      {
        "name": "Europe (AMPEDUP! supported XISO)",
        "size": 2016346112,
        "crc32": "922d8f9c"
      }
    ]
  },
  "start": {
    "program": [
      "AMPEDUP!.exe"
    ],
    "args": [
      "--play"
    ]
  },
  "prepare": {
    "program": [
      "AMPEDUP!.exe"
    ],
    "args": [
      "--prepare",
      "--game",
      "{game}"
    ],
    "label": "Download the build tools and compile AMPEDUP! from your copy. This takes several minutes.",
    "timeout": 2400,
    "version": "12",
    "done": [
      "{install}/runtime/.ampedup-runtime-r12",
      "{install}/runtime/Amped-Host/bin/amped_recomp.exe",
      "{install}/runtime/Amped-Host/bin/snow-summit-visible.ahd"
    ]
  },
  "config": [
    {
      "format": "toml",
      "file": [
        {
          "path": "{install}/profile/settings.toml"
        }
      ],
      "new": {
        "game/language": "\"english\"",
        "display/amped_native_wide": "true",
        "graphics/render_scale": "4",
        "graphics/aniso": "\"16x\"",
        "graphics/aa": "\"off\"",
        "graphics/amped_crt": "true"
      }
    }
  ],
  "settings": [
    {
      "id": "potato-mode",
      "label": "Potato Mode",
      "help": "Use 1× resolution, original textures and a 30 FPS cap. AA, anisotropic filtering and CRT turn off. Switch off to restore your graphics settings on the next launch.",
      "choices": [
        { "label": "Off", "set": { "graphics/amped_potato_mode": "false" } },
        { "label": "On", "set": { "graphics/amped_potato_mode": "true" } }
      ],
      "defaults": { "graphics/amped_potato_mode": "false" }
    },
    {
      "id": "game-language",
      "label": "Game language",
      "help": "Choose the language Amped uses the next time you start it.",
      "choices": [
        { "label": "English", "set": { "game/language": "\"english\"" } },
        { "label": "Deutsch", "set": { "game/language": "\"german\"" } },
        { "label": "Français", "set": { "game/language": "\"french\"" } },
        { "label": "Italiano", "set": { "game/language": "\"italian\"" } },
        { "label": "Español", "set": { "game/language": "\"spanish\"" } }
      ],
      "defaults": { "game/language": "\"english\"" }
    },
    {
      "id": "window",
      "label": "Window mode",
      "help": "Choose a window or fill the display.",
      "choices": [
        {
          "label": "Windowed",
          "set": {
            "display/fullscreen": "false"
          }
        },
        {
          "label": "Fullscreen",
          "set": {
            "display/fullscreen": "true"
          }
        }
      ],
      "defaults": {
        "display/fullscreen": "false"
      }
    },
    {
      "id": "match-fullscreen-refresh",
      "label": "Match fullscreen Hz",
      "help": "When Fullscreen is on, switch the display to the FPS cap or its lowest supported multiple at desktop resolution. With no match or no cap, use the desktop refresh rate.",
      "choices": [
        { "label": "Off", "set": { "display/amped_match_refresh": "false" } },
        { "label": "On", "set": { "display/amped_match_refresh": "true" } }
      ],
      "defaults": { "display/amped_match_refresh": "false" }
    },
    {
      "id": "vsync",
      "label": "VSync",
      "help": "Synchronize presentation with the display. Turning VSync off permits tearing on supported systems.",
      "choices": [
        { "label": "On", "set": { "display/vsync": "true" } },
        { "label": "Off", "set": { "display/vsync": "false" } }
      ],
      "defaults": { "display/vsync": "true" }
    },
    {
      "id": "aspect",
      "label": "Aspect ratio",
      "help": "Choose 4:3, native 16:9, or ultrawide gameplay with centered menus.",
      "choices": [
        {
          "label": "4:3",
          "set": {
            "display/amped_native_wide": "false",
            "display/amped_ultrawide": "false"
          }
        },
        {
          "label": "16:9",
          "set": {
            "display/amped_native_wide": "true",
            "display/amped_ultrawide": "false"
          }
        },
        {
          "label": "21:9",
          "set": {
            "display/amped_native_wide": "true",
            "display/amped_ultrawide": "true"
          }
        }
      ],
      "defaults": {
        "display/amped_native_wide": "true",
        "display/amped_ultrawide": "false"
      }
    },
    {
      "id": "scale",
      "label": "Internal resolution",
      "help": "Higher scales sharpen 3D rendering and use more GPU time.",
      "choices": [
        {
          "label": "Original",
          "set": {
            "graphics/render_scale": "1"
          }
        },
        {
          "label": "2\u00d7",
          "set": {
            "graphics/render_scale": "2"
          }
        },
        {
          "label": "3\u00d7",
          "set": {
            "graphics/render_scale": "3"
          }
        },
        {
          "label": "4\u00d7",
          "set": {
            "graphics/render_scale": "4"
          }
        }
      ],
      "defaults": {
        "graphics/render_scale": "4"
      }
    },
    {
      "id": "aa",
      "label": "Anti-aliasing",
      "help": "Smooth jagged edges with FXAA or SMAA.",
      "choices": [
        {
          "label": "Off",
          "set": {
            "graphics/aa": "\"off\""
          }
        },
        {
          "label": "FXAA",
          "set": {
            "graphics/aa": "\"fxaa\""
          }
        },
        {
          "label": "SMAA",
          "set": {
            "graphics/aa": "\"smaa\""
          }
        }
      ],
      "defaults": {
        "graphics/aa": "\"off\""
      }
    },
    {
      "id": "hd-textures",
      "label": "Course textures",
      "help": "Original uses the disc textures. HD Pack adds close-up detail to selected snow, wood, bark and metal.",
      "choices": [
        {
          "label": "Original",
          "set": {
            "graphics/amped_hd_textures": "false"
          }
        },
        {
          "label": "HD Pack",
          "set": {
            "graphics/amped_hd_textures": "true"
          }
        }
      ],
      "defaults": {
        "graphics/amped_hd_textures": "false"
      }
    },
    {
      "id": "aniso",
      "label": "Texture filtering",
      "help": "Higher values sharpen textures viewed at an angle.",
      "choices": [
        {
          "label": "Off",
          "set": {
            "graphics/aniso": "\"off\""
          }
        },
        {
          "label": "2\u00d7",
          "set": {
            "graphics/aniso": "\"2x\""
          }
        },
        {
          "label": "4\u00d7",
          "set": {
            "graphics/aniso": "\"4x\""
          }
        },
        {
          "label": "8\u00d7",
          "set": {
            "graphics/aniso": "\"8x\""
          }
        },
        {
          "label": "16\u00d7",
          "set": {
            "graphics/aniso": "\"16x\""
          }
        }
      ],
      "defaults": {
        "graphics/aniso": "\"16x\""
      }
    },
    {
      "id": "crt",
      "label": "CRT scanlines",
      "help": "Add scanlines to the final game image.",
      "choices": [
        {
          "label": "Off",
          "set": {
            "graphics/amped_crt": "false"
          }
        },
        {
          "label": "On",
          "set": {
            "graphics/amped_crt": "true"
          }
        }
      ],
      "defaults": {
        "graphics/amped_crt": "true"
      }
    },
    {
      "id": "fps",
      "label": "Frame-rate cap",
      "help": "Choose how often the game can present a frame. Timing above 60 FPS is experimental.",
      "choices": [
        {
          "label": "30 FPS",
          "set": {
            "display/amped_fps_cap": "\"30\""
          }
        },
        {
          "label": "60 FPS",
          "set": {
            "display/amped_fps_cap": "\"60\""
          }
        },
        {
          "label": "120 FPS",
          "set": {
            "display/amped_fps_cap": "\"120\""
          }
        },
        {
          "label": "Off",
          "set": {
            "display/amped_fps_cap": "\"off\""
          }
        }
      ],
      "defaults": {
        "display/amped_fps_cap": "\"60\""
      }
    }
  ],
  "saves": [
    "{install}/profile/saves/UDATA/4d530005",
    "{install}/profile/saves/TDATA/4d530005"
  ],
  "folders": {
    "saves": [
      {
        "path": "{install}/profile/saves"
      }
    ],
    "logs": [
      {
        "path": "{install}/profile/logs"
      }
    ]
  },
  "looks": {
    "allowed": false,
    "reason": "Use AMPEDUP!\u2019s built-in CRT scanlines and anti-aliasing."
  },
  "exit_codes": {
    "12": "Prepare your own copy from the AMPEDUP! page before playing."
  }
}

From 5528058ea5c3943a29c961fafd694a443428739c Mon Sep 17 00:00:00 2001
From: Quince <quinceroms@gmail.com>
Date: Sat, 21 Nov 2026 19:02:40 +0800
Subject: [PATCH] winpthreads: Destroy `spin_keys` when a detached thread exits

`_pthread_cleanup_dest()` runs on every thread exit and locks `t->spin_keys`,
so the static initializer becomes a real spinlock with its own Event.
`pthread_join()`, `_pthread_tryjoin()`, `pthread_detach()` of an ended thread
and the `DLL_THREAD_DETACH` callback destroy it with `replace_spin_keys()`,
but the paths where a detached thread frees its own `_pthread_v` do not:

- `pthread_create_wrapper()`, branch `if (!tv->h)`: a thread created detached,
  or detached while running;
- `pthread_exit()`, branch `if (!t->h)`: a thread not created by winpthreads
  that detached itself.

`push_pthread_mem()` then clears the struct and the Event is lost.

This patch fixes handle leaks by adding calls to `replace_spin_keys()` before
`push_pthread_mem()` for detached threads.

This closes https://github.com/mingw-w64/mingw-w64/issues/190.

Signed-off-by: LIU Hao <lh_mouse@126.com>
---
 mingw-w64-libraries/winpthreads/src/thread.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/mingw-w64-libraries/winpthreads/src/thread.c b/mingw-w64-libraries/winpthreads/src/thread.c
index bbf352f09..31187c238 100644
--- a/mingw-w64-libraries/winpthreads/src/thread.c
+++ b/mingw-w64-libraries/winpthreads/src/thread.c
@@ -1025,6 +1025,7 @@ pthread_exit (void *res)
   _pthread_v *t = NULL;
   unsigned rslt = (unsigned) ((intptr_t) res);
   struct _pthread_v *id = __pthread_self_lite ();
+  pthread_spinlock_t new_spin_keys = PTHREAD_SPINLOCK_INITIALIZER;
 
   id->ret_arg = res;
 
@@ -1042,6 +1043,7 @@ pthread_exit (void *res)
 	    CloseHandle (t->evStart);
 	  t->evStart = NULL;
 	  rslt = (unsigned) (size_t) t->ret_arg;
+	  replace_spin_keys (&t->spin_keys, new_spin_keys);
 	  push_pthread_mem(t);
 	  t = NULL;
 	  TlsSetValue (_pthread_tls, t);
@@ -1480,9 +1482,11 @@ pthread_create_wrapper (void *args)
   tv->evStart = NULL;
   if (!tv->h)
     {
+      pthread_spinlock_t new_spin_keys = PTHREAD_SPINLOCK_INITIALIZER;
       tv->valid = DEAD_THREAD;
       pthread_mutex_unlock (&tv->p_clock);
       pthread_mutex_destroy (&tv->p_clock);
+      replace_spin_keys (&tv->spin_keys, new_spin_keys);
       push_pthread_mem (tv);
       tv = NULL;
       TlsSetValue (_pthread_tls, tv);

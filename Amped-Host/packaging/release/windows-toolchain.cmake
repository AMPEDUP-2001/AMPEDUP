set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)

set(LLVM_MINGW_ROOT "" CACHE PATH "Root of the Windows x64 LLVM-MinGW toolchain")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES LLVM_MINGW_ROOT)
set(_bin "${LLVM_MINGW_ROOT}/bin")
find_program(_cc x86_64-w64-mingw32-clang HINTS "${_bin}" REQUIRED)
find_program(_cxx x86_64-w64-mingw32-clang++ HINTS "${_bin}" REQUIRED)
find_program(_rc x86_64-w64-mingw32-windres HINTS "${_bin}" REQUIRED)
set(CMAKE_C_COMPILER "${_cc}")
set(CMAKE_CXX_COMPILER "${_cxx}")
set(CMAKE_RC_COMPILER "${_rc}")

set(CMAKE_FIND_ROOT_PATH "${LLVM_MINGW_ROOT}/x86_64-w64-mingw32" ${CMAKE_PREFIX_PATH})
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

option(AMPED_AUDIO_MENU_VIRTUAL "Build isolated SDL virtual audio-menu controls" OFF)
if(AMPED_AUDIO_MENU_VIRTUAL)
 if(NOT AMPED_SDL_CLAIM_DIAGNOSTIC)
  message(FATAL_ERROR "Audio-menu virtual test requires the virtual controller diagnostic")
 endif()
 get_target_property(_audio_menu_sources xbox_video SOURCES)
 list(FILTER _audio_menu_sources EXCLUDE REGEX "/sdl_virtual_game\\.c$")
 set_property(TARGET xbox_video PROPERTY SOURCES "${_audio_menu_sources}")
 target_sources(xbox_video PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/probes/audio_menu/sdl_virtual_audio_menu.c")
endif()
option(AMPED_AUDIO_VM_PROBE "Build isolated Lua audio-menu fault observer" OFF)
if(AMPED_AUDIO_VM_PROBE)
 if(NOT AMPED_AUDIO_MENU_VIRTUAL OR NOT AMPED_GENERATED_DIR MATCHES "seeded-v23/generated$")
  message(FATAL_ERROR "Audio VM probe requires the isolated v23 audio menu build")
 endif()
 get_target_property(_audio_vm_sources amped_recomp SOURCES)
 list(FILTER _audio_vm_sources EXCLUDE REGEX "/recomp_0042\\.c$")
 list(FILTER _audio_vm_sources EXCLUDE REGEX "/recomp_0041\\.c$")
 set_property(TARGET amped_recomp PROPERTY SOURCES "${_audio_vm_sources}")
 target_sources(amped_recomp PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/probes/audio_menu/recomp_0041_audio_vm.c" "${CMAKE_CURRENT_SOURCE_DIR}/probes/audio_menu/recomp_0042_audio_vm.c" "${CMAKE_CURRENT_SOURCE_DIR}/probes/audio_menu/vm_trace.c")
endif()
option(AMPED_AUDIO_BRANCH_FIX "Use isolated reconstructed audio callback branch blocks" OFF)
if(AMPED_AUDIO_BRANCH_FIX)
 if(NOT AMPED_GENERATED_DIR MATCHES "seeded-v23/generated$")
  message(FATAL_ERROR "Audio branch fix requires v23 generated sources")
 endif()
 get_target_property(_audio_fix_sources amped_recomp SOURCES)
 list(FILTER _audio_fix_sources EXCLUDE REGEX "/recomp_0007\\.c$")
 set_property(TARGET amped_recomp PROPERTY SOURCES "${_audio_fix_sources}")
 target_sources(amped_recomp PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/probes/audio_menu/recomp_0007_audio_fix.c")
endif()

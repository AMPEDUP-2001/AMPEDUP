option(AMPED_PHASE_PROBE_V23 "Build bounded v23 HUD/rider phase observer" OFF)
option(AMPED_PHASE_ACTION_COMBINED_V23 "Compose isolated phase and terrain action observations" OFF)
if(AMPED_PHASE_ACTION_COMBINED_V23 AND (NOT AMPED_PHASE_PROBE_V23 OR NOT AMPED_TERRAIN_ATTEMPT_V23 OR NOT AMPED_A_ACTION_PROBE_V23))
 message(FATAL_ERROR "Phase/action composition requires the phase, terrain attempt and action probes")
endif()
if(AMPED_PHASE_PROBE_V23)
 if(NOT AMPED_GENERATED_DIR MATCHES "seeded-v23/generated$" OR (AMPED_A_ACTION_PROBE_V23 AND NOT AMPED_PHASE_ACTION_COMBINED_V23))
  message(FATAL_ERROR "Phase probe requires v23 and conflicts with the action chunk observer")
 endif()
 get_target_property(_phase_src amped_recomp SOURCES)
 list(FILTER _phase_src EXCLUDE REGEX "/recomp_0010\\.c$")
 list(FILTER _phase_src EXCLUDE REGEX "/recomp_0018\\.c$")
 if(AMPED_PHASE_ACTION_COMBINED_V23)
  list(FILTER _phase_src EXCLUDE REGEX "/recomp_0018_action_v23\\.c$")
  set(_phase_0018 "${CMAKE_CURRENT_SOURCE_DIR}/probes/terrain_attempt_v23/recomp_0018_action_phase_v23.c")
  if(NOT EXISTS "${_phase_0018}")
   message(FATAL_ERROR "Generate the private phase/action composition first")
  endif()
 else()
  set(_phase_0018 "${CMAKE_CURRENT_SOURCE_DIR}/probes/fps_phase/recomp_0018_phase_v23.c")
 endif()
 set_property(TARGET amped_recomp PROPERTY SOURCES "${_phase_src}")
 target_sources(amped_recomp PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/probes/fps_phase/recomp_0010_phase_v23.c" "${_phase_0018}" "${CMAKE_CURRENT_SOURCE_DIR}/probes/fps_phase/phase_trace.c")
endif()

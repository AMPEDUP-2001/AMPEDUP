option(AMPED_EMBEDDED_MOVIE_V23 "Bounded read-only menu movie callback observer" OFF)
if(AMPED_EMBEDDED_MOVIE_V23)
  if(NOT WIN32 OR NOT AMPED_GENERATED_DIR MATCHES "seeded-v23/generated$" OR AMPED_A_ACTION_PROBE_V23)
    message(FATAL_ERROR "Embedded movie observer requires Windows v23 and excludes action probe chunk 0018")
  endif()
  find_package(Python3 COMPONENTS Interpreter REQUIRED)
  set(_embedded_dir "${CMAKE_CURRENT_BINARY_DIR}/embedded-movie-v23")
  execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/probes/embedded_movie_v23/prepare.py" --source-dir "${AMPED_GENERATED_DIR}" --output-dir "${_embedded_dir}" RESULT_VARIABLE _embedded_status)
  if(NOT _embedded_status EQUAL 0)
    message(FATAL_ERROR "Embedded movie anchor validation failed")
  endif()
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/probes/embedded_movie_v23/prepare.py" "${AMPED_GENERATED_DIR}/recomp_0007.c" "${AMPED_GENERATED_DIR}/recomp_0008.c" "${AMPED_GENERATED_DIR}/recomp_0018.c")
  get_target_property(_embedded_sources amped_recomp SOURCES)
  list(FILTER _embedded_sources EXCLUDE REGEX "/recomp_(0007|0008|0018)\\.c$")
  set_property(TARGET amped_recomp PROPERTY SOURCES "${_embedded_sources}")
  target_sources(amped_recomp PRIVATE "${_embedded_dir}/recomp_0007.c" "${_embedded_dir}/recomp_0008.c" "${_embedded_dir}/recomp_0018.c" "${CMAKE_CURRENT_SOURCE_DIR}/probes/embedded_movie_v23/embedded.c")
endif()

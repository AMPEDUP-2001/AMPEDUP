option(AMPED_LUA_RANDOM_CANDIDATE "Use isolated coalesced Lua random callback" OFF)
if(AMPED_LUA_RANDOM_CANDIDATE)
 if(NOT AMPED_GENERATED_DIR MATCHES "seeded-v23/generated$")
  message(FATAL_ERROR "Lua random candidate requires v23 generated sources")
 endif()
 get_target_property(_random_sources amped_recomp SOURCES)
 list(FILTER _random_sources EXCLUDE REGEX "/recomp_0044\\.c$")
 set_property(TARGET amped_recomp PROPERTY SOURCES "${_random_sources}")
 target_sources(amped_recomp PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/probes/lua_random_v23/recomp_0044_random_v23.c")
endif()

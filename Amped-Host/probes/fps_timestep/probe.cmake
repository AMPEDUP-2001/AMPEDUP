option(AMPED_TIMESTEP_PROBE_V23 "Build v23 guest timestep observation" OFF)
if(AMPED_TIMESTEP_PROBE_V23)
 if(NOT AMPED_GENERATED_DIR MATCHES "seeded-v23/generated$")
  message(FATAL_ERROR "The timestep observer requires seeded-v23/generated")
 endif()
 if(NOT EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/probes/fps_timestep/recomp_0028_timestep_v23.c")
  message(FATAL_ERROR "Run probes/fps_timestep/prepare.py first")
 endif()
 get_target_property(_amped_timestep_sources amped_recomp SOURCES)
 list(FILTER _amped_timestep_sources EXCLUDE REGEX "/recomp_0028\\.c$")
 set_property(TARGET amped_recomp PROPERTY SOURCES "${_amped_timestep_sources}")
 target_sources(amped_recomp PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/probes/fps_timestep/recomp_0028_timestep_v23.c" "${CMAKE_CURRENT_SOURCE_DIR}/probes/fps_timestep/timestep_trace.c")
endif()

option(AMPED_CAREER_PAUSE_Y "Build isolated Career pause Y observer" OFF)
if(AMPED_CAREER_PAUSE_Y)
  if(NOT AMPED_GENERATED_DIR MATCHES "seeded-v23/generated$" OR AMPED_LUA_INPUT_PROBE_V23)
    message(FATAL_ERROR "Career pause Y observer requires v23 and an unmodified 0032 chunk")
  endif()
  find_package(Python3 COMPONENTS Interpreter REQUIRED)
  set(_career_y "${CMAKE_CURRENT_BINARY_DIR}/career_pause_y_recomp_0032.c")
  execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/probes/career_pause_y_v23/prepare.py"
    --source "${AMPED_GENERATED_DIR}/recomp_0032.c" --output "${_career_y}" RESULT_VARIABLE _career_y_result)
  if(NOT _career_y_result EQUAL 0)
    message(FATAL_ERROR "Career pause Y source anchor validation failed")
  endif()
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/probes/career_pause_y_v23/prepare.py" "${AMPED_GENERATED_DIR}/recomp_0032.c")
  get_target_property(_career_y_sources amped_recomp SOURCES)
  list(FILTER _career_y_sources EXCLUDE REGEX "/recomp_0032\\.c$")
  set_property(TARGET amped_recomp PROPERTY SOURCES "${_career_y_sources}")
  target_sources(amped_recomp PRIVATE "${_career_y}" "${CMAKE_CURRENT_SOURCE_DIR}/probes/career_pause_y_v23/trace.c")
endif()

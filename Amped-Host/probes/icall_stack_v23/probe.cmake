option(AMPED_LUA_CDECL_FALLBACK_V23 "Isolated Lua cdecl indirect-failure stack correction" OFF)
if(AMPED_LUA_CDECL_FALLBACK_V23)
 if(NOT AMPED_GENERATED_DIR MATCHES "seeded-v23/generated$")
  message(FATAL_ERROR "Lua cdecl fallback experiment requires v23 generated sources")
 endif()
 find_package(Python3 COMPONENTS Interpreter REQUIRED)
 get_target_property(_lua_cdecl_sources amped_recomp SOURCES)
 set(_lua_cdecl_matches ${_lua_cdecl_sources})
 list(FILTER _lua_cdecl_matches INCLUDE REGEX "/recomp_0041(_audio_vm)?\\.c$")
 list(LENGTH _lua_cdecl_matches _lua_cdecl_count)
 if(NOT _lua_cdecl_count EQUAL 1)
  message(FATAL_ERROR "Lua cdecl experiment requires exactly one compatible 0041 source")
 endif()
 list(GET _lua_cdecl_matches 0 _lua_cdecl_input)
 set(_lua_cdecl_out "${CMAKE_CURRENT_BINARY_DIR}/lua-cdecl-fallback-v23/recomp_0041.c")
 execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/probes/icall_stack_v23/prepare_fix.py" --source "${_lua_cdecl_input}" --output "${_lua_cdecl_out}" RESULT_VARIABLE _lua_cdecl_status)
 if(NOT _lua_cdecl_status EQUAL 0)
  message(FATAL_ERROR "Lua cdecl experiment anchor validation failed")
 endif()
 set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/probes/icall_stack_v23/prepare_fix.py" "${_lua_cdecl_input}")
 list(REMOVE_ITEM _lua_cdecl_sources "${_lua_cdecl_input}")
 set_property(TARGET amped_recomp PROPERTY SOURCES "${_lua_cdecl_sources}")
 target_sources(amped_recomp PRIVATE "${_lua_cdecl_out}")
endif()

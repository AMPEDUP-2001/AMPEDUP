option(AMPED_DISABLE_DEMOS_V23 "Isolated Game Demos disabled notice" OFF)
if(AMPED_DISABLE_DEMOS_V23)
 if(NOT WIN32 OR NOT TARGET xbox_overlay OR NOT AMPED_GENERATED_DIR MATCHES "seeded-v23/generated$")
  message(FATAL_ERROR "Demo notice requires Windows, overlay, and v23 generated sources")
 endif()
 find_package(Python3 REQUIRED COMPONENTS Interpreter)
 get_target_property(_demo_guest amped_recomp SOURCES)
 set(_demo_match ${_demo_guest})
 list(FILTER _demo_match INCLUDE REGEX "/recomp_0007(_audio_fix)?\\.c$")
 list(LENGTH _demo_match _demo_count)
 if(NOT _demo_count EQUAL 1)
  message(FATAL_ERROR "Expected exactly one compatible 0007 chunk")
 endif()
 list(GET _demo_match 0 _demo_in)
 set(_demo_overlay "${XBOXRECOMP_DIR}/src/overlay/overlay_ui.cpp")
 set(_demo_out "${CMAKE_CURRENT_BINARY_DIR}/disable-demos-v23")
 execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/probes/disable_demos_v23/prepare.py" --guest "${_demo_in}" --overlay "${_demo_overlay}" --out "${_demo_out}" RESULT_VARIABLE _demo_status)
 if(NOT _demo_status EQUAL 0)
  message(FATAL_ERROR "Demo notice exact-anchor preparation failed")
 endif()
 set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_demo_in}" "${_demo_overlay}" "${CMAKE_CURRENT_SOURCE_DIR}/probes/disable_demos_v23/prepare.py")
 list(REMOVE_ITEM _demo_guest "${_demo_in}")
 set_property(TARGET amped_recomp PROPERTY SOURCES "${_demo_guest}")
 target_sources(amped_recomp PRIVATE "${_demo_out}/recomp_0007.c")
 get_target_property(_demo_ui xbox_overlay SOURCES)
 list(FILTER _demo_ui EXCLUDE REGEX "(^|/)overlay_ui\\.cpp$")
 set_property(TARGET xbox_overlay PROPERTY SOURCES "${_demo_ui}")
 target_sources(xbox_overlay PRIVATE "${_demo_out}/overlay_ui.cpp")
endif()

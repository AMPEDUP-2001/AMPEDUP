option(AMPED_DEMO_ACTION_REDIRECT "Isolated exact DVD read redirect for demos action test" OFF)
if(AMPED_DEMO_ACTION_REDIRECT)
 if(NOT WIN32 OR NOT AMPED_DISABLE_DEMOS_V23)
  message(FATAL_ERROR "Demo action redirect requires Windows and demos notice candidate")
 endif()
 get_target_property(_asset_sources xbox_kernel SOURCES)
 set(_asset_match ${_asset_sources})
 list(FILTER _asset_match INCLUDE REGEX "(^|/)kernel_file\\.c$")
 list(LENGTH _asset_match _asset_count)
 if(NOT _asset_count EQUAL 1)
  message(FATAL_ERROR "Expected exactly one kernel_file.c source")
 endif()
 list(GET _asset_match 0 _asset_original)
 list(REMOVE_ITEM _asset_sources "${_asset_original}")
 set_property(TARGET xbox_kernel PROPERTY SOURCES "${_asset_sources}")
 target_sources(xbox_kernel PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/probes/demo_action_v23/kernel_file_demo.c" "${CMAKE_CURRENT_SOURCE_DIR}/probes/demo_action_v23/redirect.c")
endif()

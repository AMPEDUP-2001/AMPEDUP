# Must be explicitly included after multiplayer_callback_v23/probe.cmake.
include_guard(GLOBAL)
option(AMPED_CAREER_56B40_CANDIDATE "Enable isolated 0x56B40 candidate" OFF)
if(AMPED_CAREER_56B40_CANDIDATE)
 if(NOT AMPED_MULTIPLAYER_CALLBACK_CANDIDATE OR NOT AMPED_GENERATED_DIR MATCHES "seeded-v23/generated$")
  message(FATAL_ERROR "0x56B40 candidate requires the v23 multiplayer candidate")
 endif()
 get_target_property(_career_sources amped_recomp SOURCES)
 set(_career_dispatch ${_career_sources})
 list(FILTER _career_dispatch INCLUDE REGEX "/recomp_dispatch_multiplayer\\.c$")
 list(LENGTH _career_dispatch _career_count)
 if(NOT _career_count EQUAL 1)
  message(FATAL_ERROR "Expected exactly one multiplayer dispatch")
 endif()
 list(REMOVE_ITEM _career_sources ${_career_dispatch})
 set_property(TARGET amped_recomp PROPERTY SOURCES "${_career_sources}")
 target_sources(amped_recomp PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/probes/career_56b40_v23/career_56b40.c" "${CMAKE_CURRENT_SOURCE_DIR}/probes/career_56b40_v23/recomp_dispatch_career.c")
endif()

option(AMPED_GUEST_CLEAR_V23 "Read-only isolated movie clear call observer" OFF)
if(AMPED_GUEST_CLEAR_V23)
  if(NOT WIN32 OR NOT AMPED_GENERATED_DIR MATCHES "seeded-v23/generated$" OR AMPED_MOVIE_BRIDGE_V23)
    message(FATAL_ERROR "Guest clear probe requires Windows v23 and excludes the movie bridge")
  endif()
  find_package(Python3 COMPONENTS Interpreter REQUIRED)
  set(_guest_clear_out "${CMAKE_CURRENT_BINARY_DIR}/guest-clear-v23/recomp_0046.c")
  execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/probes/guest_clear_v23/prepare.py" --source "${AMPED_GENERATED_DIR}/recomp_0046.c" --output "${_guest_clear_out}" RESULT_VARIABLE _guest_clear_result)
  if(NOT _guest_clear_result EQUAL 0)
    message(FATAL_ERROR "Guest clear anchor validation failed")
  endif()
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/probes/guest_clear_v23/prepare.py" "${AMPED_GENERATED_DIR}/recomp_0046.c")
  get_target_property(_guest_clear_sources amped_recomp SOURCES)
  list(FILTER _guest_clear_sources EXCLUDE REGEX "/recomp_0046\\.c$")
  set_property(TARGET amped_recomp PROPERTY SOURCES "${_guest_clear_sources}")
  target_sources(amped_recomp PRIVATE "${_guest_clear_out}" "${CMAKE_CURRENT_SOURCE_DIR}/probes/guest_clear_v23/guest_clear.c")
endif()

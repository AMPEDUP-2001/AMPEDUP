option(AMPED_CAMERA_SCRIPT_PROBE_V23 "Observe Lua SetCamera without changing guest state" OFF)
if(AMPED_CAMERA_SCRIPT_PROBE_V23)
  if(NOT AMPED_GENERATED_DIR MATCHES "seeded-v23/generated$" OR AMPED_LUA_INPUT_PROBE_V23)
    message(FATAL_ERROR "Camera probe requires v23 and cannot share chunk 0032 with Lua input probe")
  endif()
  find_package(Python3 COMPONENTS Interpreter REQUIRED)
  set(_camera_out "${CMAKE_CURRENT_BINARY_DIR}/camera-script-v23/recomp_0032.c")
  execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/probes/camera_script_v23/prepare.py"
    --source "${AMPED_GENERATED_DIR}/recomp_0032.c" --output "${_camera_out}" RESULT_VARIABLE _camera_status)
  if(NOT _camera_status EQUAL 0)
    message(FATAL_ERROR "Camera probe anchor generation failed")
  endif()
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${CMAKE_CURRENT_SOURCE_DIR}/probes/camera_script_v23/prepare.py" "${AMPED_GENERATED_DIR}/recomp_0032.c")
  get_target_property(_camera_sources amped_recomp SOURCES)
  list(FILTER _camera_sources EXCLUDE REGEX "/recomp_0032\\.c$")
  set_property(TARGET amped_recomp PROPERTY SOURCES "${_camera_sources}")
  target_sources(amped_recomp PRIVATE "${_camera_out}" "${CMAKE_CURRENT_SOURCE_DIR}/probes/camera_script_v23/trace.c")
endif()

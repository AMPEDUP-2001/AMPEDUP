option(AMPED_REPLAY_SAVE_4F880_CANDIDATE "Enable isolated replay save worker candidate" OFF)
include_guard(GLOBAL)
if(AMPED_REPLAY_SAVE_4F880_CANDIDATE)
 if(NOT AMPED_CAREER_56B40_CANDIDATE)
  message(FATAL_ERROR "Replay worker requires the isolated Career candidate")
 endif()
 get_target_property(_replay_sources amped_recomp SOURCES)
 set(_replay_dispatch ${_replay_sources})
 list(FILTER _replay_dispatch INCLUDE REGEX "/recomp_dispatch_career\\.c$")
 list(LENGTH _replay_dispatch _replay_count)
 if(NOT _replay_count EQUAL 1)
  message(FATAL_ERROR "Expected exactly one Career dispatch")
 endif()
 list(REMOVE_ITEM _replay_sources ${_replay_dispatch})
 set_property(TARGET amped_recomp PROPERTY SOURCES "${_replay_sources}")
 target_sources(amped_recomp PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/probes/replay_save_4f880_v23/replay_save_4f880.c" "${CMAKE_CURRENT_SOURCE_DIR}/probes/replay_save_4f880_v23/recomp_dispatch_replay_save.c")
endif()

option(AMPED_MULTIPLAYER_CALLBACK_CANDIDATE "Enable isolated multiplayer character-list callback" OFF)
if(AMPED_MULTIPLAYER_CALLBACK_CANDIDATE)
 if(NOT AMPED_REPLAY_CALLBACK_CANDIDATE OR NOT AMPED_GENERATED_DIR MATCHES "seeded-v23/generated$")
  message(FATAL_ERROR "Multiplayer callback candidate requires v23 replay candidate")
 endif()
 get_target_property(_multiplayer_sources amped_recomp SOURCES)
 set(_multiplayer_dispatch ${_multiplayer_sources})
 list(FILTER _multiplayer_dispatch INCLUDE REGEX "/recomp_dispatch_replay\\.c$")
 list(LENGTH _multiplayer_dispatch _multiplayer_count)
 if(NOT _multiplayer_count EQUAL 1)
  message(FATAL_ERROR "Expected one replay dispatch")
 endif()
 list(REMOVE_ITEM _multiplayer_sources ${_multiplayer_dispatch})
 set_property(TARGET amped_recomp PROPERTY SOURCES "${_multiplayer_sources}")
 target_sources(amped_recomp PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/probes/multiplayer_callback_v23/multiplayer_v23.c" "${CMAKE_CURRENT_SOURCE_DIR}/probes/multiplayer_callback_v23/recomp_dispatch_multiplayer.c")
endif()

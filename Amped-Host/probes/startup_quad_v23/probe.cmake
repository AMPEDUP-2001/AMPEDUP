option(AMPED_STARTUP_QUAD_V23 "Isolated opt-in startup movie quad experiment" OFF)
if(AMPED_STARTUP_QUAD_V23)
 if(NOT WIN32 OR NOT AMPED_GENERATED_DIR MATCHES "seeded-v23/generated$" OR AMPED_MOVIE_BRIDGE_V23 OR AMPED_GUEST_CLEAR_V23 OR NOT AMPED_NATIVE_VIDEO_EXPERIMENT_V23)
  message(FATAL_ERROR "Startup quad experiment requires isolated native-video v23 and excludes other 0046 probes")
 endif()
 find_package(Python3 COMPONENTS Interpreter REQUIRED)
 set(_sq_out "${CMAKE_CURRENT_BINARY_DIR}/startup-quad-v23/recomp_0046.c")
 execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/probes/startup_quad_v23/prepare.py" --source "${AMPED_GENERATED_DIR}/recomp_0046.c" --output "${_sq_out}" RESULT_VARIABLE _sq_result)
 if(NOT _sq_result EQUAL 0)
  message(FATAL_ERROR "Startup quad anchor validation failed")
 endif()
 if(CMAKE_C_COMPILER_ID MATCHES "Clang")
  set_source_files_properties("${_sq_out}" PROPERTIES COMPILE_OPTIONS "-fms-extensions")
 elseif(NOT MSVC)
  message(FATAL_ERROR "Startup quad scope cleanup requires Windows SEH finally support")
 endif()
 set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/probes/startup_quad_v23/prepare.py" "${AMPED_GENERATED_DIR}/recomp_0046.c")
 get_target_property(_sq_sources amped_recomp SOURCES)
 list(FILTER _sq_sources EXCLUDE REGEX "/recomp_0046\\.c$")
 set_property(TARGET amped_recomp PROPERTY SOURCES "${_sq_sources}")
 target_sources(amped_recomp PRIVATE "${_sq_out}" "${CMAKE_CURRENT_SOURCE_DIR}/probes/startup_quad_v23/quad.c")
endif()
option(AMPED_NATIVE_WIDE_SETTING_V23 "Isolated restart-only native widescreen setting" OFF)
if(AMPED_NATIVE_WIDE_SETTING_V23)
 if(NOT AMPED_STARTUP_QUAD_V23 OR NOT AMPED_NATIVE_VIDEO_EXPERIMENT_V23 OR NOT AMPED_SETTINGS_EXPERIMENT)
  message(FATAL_ERROR "Native wide setting requires the isolated startup quad and native video builds")
 endif()
 target_compile_definitions(amped_recomp PRIVATE AMPED_NATIVE_WIDE_SETTING_V23=1)
 target_compile_definitions(xbox_overlay PRIVATE AMPED_NATIVE_WIDE_SETTING_V23=1)
endif()

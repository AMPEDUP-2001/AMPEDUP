option(AMPED_LOADING_STRIP_V23 "Observe the loading movie callsite in isolation" OFF)
if(AMPED_LOADING_STRIP_V23)
 if(NOT WIN32 OR NOT AMPED_GENERATED_DIR MATCHES "seeded-v23/generated$" OR AMPED_PAUSE_PROBE_V23 OR AMPED_MENU_CONSUMER_PROBE_V23 OR AMPED_CONTINUE_PROBE_V23)
  message(FATAL_ERROR "Loading strip observer requires Windows v23 and excludes competing chunk 0005/0006 probes")
 endif()
 find_package(Python3 COMPONENTS Interpreter REQUIRED)
 set(_loading_out "${CMAKE_CURRENT_BINARY_DIR}/loading-strip-v23/recomp_0006.c")
 set(_loading_direct "${CMAKE_CURRENT_BINARY_DIR}/loading-strip-v23/recomp_0005.c")
 execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/probes/loading_strip_v23/prepare.py" --source "${AMPED_GENERATED_DIR}/recomp_0006.c" --output "${_loading_out}" --source-direct "${AMPED_GENERATED_DIR}/recomp_0005.c" --output-direct "${_loading_direct}" RESULT_VARIABLE _loading_status)
 if(NOT _loading_status EQUAL 0)
  message(FATAL_ERROR "Loading strip anchor validation failed")
 endif()
 set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/probes/loading_strip_v23/prepare.py" "${AMPED_GENERATED_DIR}/recomp_0006.c" "${AMPED_GENERATED_DIR}/recomp_0005.c")
 get_target_property(_loading_sources amped_recomp SOURCES)
 list(FILTER _loading_sources EXCLUDE REGEX "/recomp_0006\\.c$")
 list(FILTER _loading_sources EXCLUDE REGEX "/recomp_0005\\.c$")
 set_property(TARGET amped_recomp PROPERTY SOURCES "${_loading_sources}")
 target_compile_definitions(amped_recomp PRIVATE AMPED_LOADING_STRIP_V23=1)
 target_sources(amped_recomp PRIVATE "${_loading_out}" "${_loading_direct}" "${CMAKE_CURRENT_SOURCE_DIR}/probes/loading_strip_v23/loading.c")
endif()

option(AMPED_MENU_LIFECYCLE_V23 "Read-only allowlisted menu lifecycle trace" OFF)
if(AMPED_MENU_LIFECYCLE_V23)
  if(NOT AMPED_CAMERA_SCRIPT_PROBE_V23 OR NOT AMPED_GENERATED_DIR MATCHES "seeded-v23/generated$")
    message(FATAL_ERROR "Menu lifecycle trace requires v23 camera-script derived chunk")
  endif()
  find_package(Python3 COMPONENTS Interpreter REQUIRED)
  set(_lifecycle_out "${CMAKE_CURRENT_BINARY_DIR}/menu-lifecycle-v23/recomp_0032.c")
  execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/probes/menu_lifecycle_v23/prepare.py"
    --source "${_camera_out}" --output "${_lifecycle_out}" RESULT_VARIABLE _lifecycle_status)
  if(NOT _lifecycle_status EQUAL 0)
    message(FATAL_ERROR "Menu lifecycle anchor generation failed")
  endif()
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/probes/menu_lifecycle_v23/prepare.py")
  get_target_property(_lifecycle_sources amped_recomp SOURCES)
  list(REMOVE_ITEM _lifecycle_sources "${_camera_out}")
  set_property(TARGET amped_recomp PROPERTY SOURCES "${_lifecycle_sources}")
  target_compile_definitions(amped_recomp PRIVATE AMPED_MENU_LIFECYCLE_V23=1)
  target_sources(amped_recomp PRIVATE "${_lifecycle_out}" "${CMAKE_CURRENT_SOURCE_DIR}/probes/menu_lifecycle_v23/trace.c")
endif()

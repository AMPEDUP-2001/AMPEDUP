option(AMPED_WIDESCREEN_EXPERIMENT_V23 "Isolated, partial v23 16:9 experiment" OFF)
if(AMPED_WIDESCREEN_EXPERIMENT_V23)
  if(NOT AMPED_SETTINGS_EXPERIMENT OR NOT AMPED_GENERATED_DIR MATCHES "seeded-v23/generated$")
    message(FATAL_ERROR "Widescreen experiment requires isolated v23 settings build")
  endif()
  find_package(Python3 COMPONENTS Interpreter REQUIRED)
  set(_wide_out "${CMAKE_CURRENT_BINARY_DIR}/widescreen-v23/recomp_0020.c")
  execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/probes/widescreen_v23/prepare.py"
    --source "${AMPED_GENERATED_DIR}/recomp_0020.c" --output "${_wide_out}" RESULT_VARIABLE _wide_status)
  if(NOT _wide_status EQUAL 0)
    message(FATAL_ERROR "Widescreen camera anchor generation failed")
  endif()
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${CMAKE_CURRENT_SOURCE_DIR}/probes/widescreen_v23/prepare.py" "${AMPED_GENERATED_DIR}/recomp_0020.c")
  get_target_property(_wide_sources amped_recomp SOURCES)
  list(FILTER _wide_sources EXCLUDE REGEX "/recomp_0020\\.c$")
  set_property(TARGET amped_recomp PROPERTY SOURCES "${_wide_sources}")
  target_compile_definitions(amped_recomp PRIVATE AMPED_WIDESCREEN_EXPERIMENT_V23=1)
  target_sources(amped_recomp PRIVATE "${_wide_out}" "${CMAKE_CURRENT_SOURCE_DIR}/probes/widescreen_v23/wide.c")
endif()


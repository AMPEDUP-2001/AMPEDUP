option(AMPED_PROJECTION_PROBE_V23 "Observe guest perspective constructor" OFF)
if(AMPED_PROJECTION_PROBE_V23)
  if(NOT AMPED_GENERATED_DIR MATCHES "seeded-v23/generated$")
    message(FATAL_ERROR "Projection probe requires seeded-v23 generated tree")
  endif()
  find_package(Python3 COMPONENTS Interpreter REQUIRED)
  set(_projection_out "${CMAKE_CURRENT_BINARY_DIR}/projection-v23/recomp_0052.c")
  execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/probes/projection_v23/prepare.py"
    --source "${AMPED_GENERATED_DIR}/recomp_0052.c" --output "${_projection_out}" RESULT_VARIABLE _projection_status)
  if(NOT _projection_status EQUAL 0)
    message(FATAL_ERROR "Projection probe anchor generation failed")
  endif()
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${CMAKE_CURRENT_SOURCE_DIR}/probes/projection_v23/prepare.py" "${AMPED_GENERATED_DIR}/recomp_0052.c")
  get_target_property(_projection_sources amped_recomp SOURCES)
  list(FILTER _projection_sources EXCLUDE REGEX "/recomp_0052\\.c$")
  set_property(TARGET amped_recomp PROPERTY SOURCES "${_projection_sources}")
  target_sources(amped_recomp PRIVATE "${_projection_out}" "${CMAKE_CURRENT_SOURCE_DIR}/probes/projection_v23/trace.c")
endif()

option(AMPED_PROJECTION_CORRELATE_V23 "Correlate cull camera projection with draw constants" OFF)
if(AMPED_PROJECTION_CORRELATE_V23)
  if(NOT AMPED_PROJECTION_PROBE_V23 OR NOT AMPED_BOARDER_PROBE_V23)
    message(FATAL_ERROR "Projection correlation requires projection and boarder v23 probes")
  endif()
  target_compile_definitions(amped_recomp PRIVATE AMPED_PROJECTION_CORRELATE_V23=1)
  target_compile_definitions(xbox_d3d8 PRIVATE AMPED_PROJECTION_CORRELATE_V23=1)
  target_sources(xbox_d3d8 PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/probes/projection_v23/correlate.c")
endif()

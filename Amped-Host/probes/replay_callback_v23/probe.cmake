option(AMPED_REPLAY_CALLBACK_CANDIDATE "Enable isolated replay list callback" OFF)
if(AMPED_REPLAY_CALLBACK_CANDIDATE)
 if(NOT AMPED_PLAYEOR_CANDIDATE OR NOT AMPED_GENERATED_DIR MATCHES "seeded-v23/generated$")
  message(FATAL_ERROR "Replay callback candidate requires v23 Soundtracks candidate")
 endif()
 get_target_property(_replay_sources amped_recomp SOURCES)
 list(FILTER _replay_sources EXCLUDE REGEX "/recomp_dispatch_playeor\\.c$")
 set_property(TARGET amped_recomp PROPERTY SOURCES "${_replay_sources}")
 target_sources(amped_recomp PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/probes/replay_callback_v23/replay_v23.c" "${CMAKE_CURRENT_SOURCE_DIR}/probes/replay_callback_v23/recomp_dispatch_replay.c")
endif()
